# Copy to application-local.properties (git-ignored) or set the LLM_API_KEY environment variable instead.
# Without a key the app still runs: the AI strategy falls back to rule-based suggestions (marked RULE_FALLBACK).
llm.api-key=
# llm.base-url=https://litellm-qc.zycus.net
# llm.model=gpt-5.6-luna-azure-payg-global
# llm.extra-headers.product=PC1
#
# Any OpenAI-compatible provider works:
# Groq:   llm.base-url=https://api.groq.com/openai   llm.model=llama-3.1-8b-instant
# Ollama: llm.base-url=http://localhost:11434        llm.model=llama3.1   (llm.api-key=ollama)
# Gemini: llm.base-url=https://generativelanguage.googleapis.com  llm.chat-path=/v1beta/openai/chat/completions  llm.model=gemini-1.5-flash
